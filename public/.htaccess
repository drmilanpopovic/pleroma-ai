Options -Indexes
DirectoryIndex index.html
Require all granted
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "DENY"
Header always set Cache-Control "no-store"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
</IfModule>
<FilesMatch "\.(sqlite|db|env|log|bak|zip|md|jsonl)$">
Require all denied
</FilesMatch>
